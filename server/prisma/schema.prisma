generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  COACH
  ATHLETE
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           Role
  isActive       Boolean         @default(true)
  tokenVersion   Int             @default(0)
  athleteProfile AthleteProfile?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([role])
}

model AthleteProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  phase           String
  phaseStartedAt  DateTime         @default(now())
  coachNotes      String           @default("")
  rehabProfile    String           @default("{\"inhibitedMuscles\":[],\"padPlacementImages\":[]}")
  programmingDays Int              @default(3)
  trainingModel   String           @default("10-Week")
  programVariant  String           @default("Standard")
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifts           Lift[]
  rehabNotes      RehabNote[]
  forcedecksTests ForceDecksTest[]
}

model Lift {
  id           String         @id @default(cuid())
  athleteId    String
  date         DateTime
  blockLabel   String         @default("")
  exerciseName String
  sets         Int
  reps         Int
  weight       String
  notes        String         @default("")
  completed    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  athlete      AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, date])
}

model RehabNote {
  id        String         @id @default(cuid())
  athleteId String
  note      String
  createdAt DateTime       @default(now())
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, createdAt])
}

// VALD ForceDecks test results. One row per test session, with N
// child ForceDecksMetric rows (one per measured metric). Readiness
// score is computed externally (CV-based formula) and stored here
// directly — no business logic on this end. externalId is the VALD
// test id, used for idempotent ingest.
model ForceDecksTest {
  id             String             @id @default(cuid())
  athleteId      String
  testDate       DateTime
  readinessScore Int?
  source         String             @default("vald")
  externalId     String?            @unique
  createdAt      DateTime           @default(now())
  athlete        AthleteProfile     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  metrics        ForceDecksMetric[]

  @@index([athleteId, testDate])
}

model ForceDecksMetric {
  id         String         @id @default(cuid())
  testId     String
  metricName String
  value      Float
  unit       String
  test       ForceDecksTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, metricName])
  @@index([metricName])
}

// Audit trail for high-trust admin actions (coach lifecycle, athlete
// deletion, password resets, auth attempts). Actor + target are stored
// as snapshotted strings rather than foreign keys so the row survives
// the deletion of the user it references. Metadata is free-form JSON
// (stored as a string because SQLite has no JSON type).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String   @default("")
  actorRole   Role?
  action      String
  targetType  String   @default("")
  targetId    String?
  targetLabel String   @default("")
  ip          String   @default("")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetId])
  @@index([actorId])
}
