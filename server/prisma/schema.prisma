generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  COACH
  ATHLETE
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           Role
  isActive       Boolean         @default(true)
  tokenVersion   Int             @default(0)
  athleteProfile AthleteProfile?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([role])
}

model AthleteProfile {
  id                      String           @id @default(cuid())
  userId                  String           @unique
  phase                   String
  phaseStartedAt          DateTime         @default(now())
  coachNotes              String           @default("")
  rehabProfile            String           @default("{\"inhibitedMuscles\":[],\"padPlacementImages\":[]}")
  programmingDays         Int              @default(3)
  trainingModel           String           @default("10-Week")
  programVariant          String           @default("Standard")
  hideFromLeaderboard     Boolean          @default(false)
  valdProfileId           String?          @unique
  valdLastSyncedAt        DateTime?
  onezeroProfileId        String?          @unique
  onezeroLastSyncedAt     DateTime?
  updatedAt               DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lifts           Lift[]
  rehabNotes      RehabNote[]
  forcedecksTests ForceDecksTest[]
  sprintSessions  SprintSession[]
}

model Lift {
  id           String         @id @default(cuid())
  athleteId    String
  date         DateTime
  blockLabel   String         @default("")
  exerciseName String
  sets         Int
  reps         Int
  weight       String
  notes        String         @default("")
  completed    Boolean        @default(false)
  // What the athlete actually used (free-text, e.g. "225 lb" or
  // "55 lb DBs"). Distinct from `weight`, which is the coach's
  // prescription. Drives the "Last: X" caption shown when the same
  // exercise appears again later.
  loggedWeight String?
  // Display order within a single day. Populated by apply-program
  // (sequential by program template). Manually-added lifts get the
  // next available value at insert time. Without this, lifts inserted
  // in a single createMany share createdAt and render in undefined
  // order.
  orderIndex   Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  athlete      AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, date])
}

model RehabNote {
  id        String         @id @default(cuid())
  athleteId String
  note      String
  createdAt DateTime       @default(now())
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, createdAt])
}

// VALD ForceDecks test results. One row per test session, with N
// child ForceDecksMetric rows (one per measured metric). Readiness
// score is computed server-side from the 4-metric personal-baseline
// equation (see server/src/utils/readiness.js). readinessScore is the
// rounded displayed value used by every UI surface; readinessDetails
// carries the full breakdown (raw, confidence, status, baselines,
// deltas) for trend analysis.
model ForceDecksTest {
  id               String             @id @default(cuid())
  athleteId        String
  testDate         DateTime
  readinessScore   Int?
  readinessDetails Json?
  source           String             @default("vald")
  externalId       String?            @unique
  createdAt        DateTime           @default(now())
  athlete          AthleteProfile     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  metrics          ForceDecksMetric[]

  @@index([athleteId, testDate])
}

model ForceDecksMetric {
  id         String         @id @default(cuid())
  testId     String
  metricName String
  value      Float
  unit       String
  test       ForceDecksTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, metricName])
  @@index([metricName])
}

// 1080 Motion (1080 Sprint) session data. A single coach-driven test
// session usually contains multiple sprints across varying resistance
// loads (e.g., for a force-velocity profile). Each Sprint row holds
// the headline kinematics inline because they're universal across the
// device; anything 1080 returns beyond those lives in `metricsJson`
// as { key: { value, unit } } so we don't have to migrate every time
// the API surfaces a new field.
model SprintSession {
  id          String         @id @default(cuid())
  athleteId   String
  sessionDate DateTime
  source      String         @default("onezero")
  externalId  String?        @unique
  notes       String         @default("")
  createdAt   DateTime       @default(now())
  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sprints     Sprint[]

  @@index([athleteId, sessionDate])
}

model Sprint {
  id           String        @id @default(cuid())
  sessionId    String
  orderIndex   Int           @default(0)
  // Resistance setting on 1080 (kg). 0 = unloaded.
  load         Float
  // Sprint distance in meters. Required for the leaderboard's
  // minimum-distance guard (peak velocity is only honest once the
  // sprint clears the acceleration phase).
  distance     Float
  // Headline kinematics — populated for every sprint by the device.
  peakVelocity Float?
  peakPower    Float?
  peakForce    Float?
  // Anything else from 1080 (split times, mean values, F-v outputs,
  // etc.) — stored as { metricKey: { value, unit } }.
  metricsJson  Json?
  session      SprintSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Audit trail for high-trust admin actions (coach lifecycle, athlete
// deletion, password resets, auth attempts). Actor + target are stored
// as snapshotted strings rather than foreign keys so the row survives
// the deletion of the user it references. Metadata is free-form JSON
// (stored as a string because SQLite has no JSON type).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorName   String   @default("")
  actorRole   Role?
  action      String
  targetType  String   @default("")
  targetId    String?
  targetLabel String   @default("")
  ip          String   @default("")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetId])
  @@index([actorId])
}

// Program library lives as a single JSON blob in Postgres so it
// survives Render's ephemeral filesystem. The id is pinned to 1 so
// reads/writes always target the same row. On first read the row is
// seeded from server/data/programLibrary.json (the source-controlled
// initial state); after that the DB is the source of truth.
model ProgramLibraryStore {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}
